{
  "_info": "Reusable application-form answers, read by `python -m jobpilot answers` (no AI). Sections are checked in this order, first match wins: do_not_answer, consents, question_bank, free_text. contact / screening / voluntary_disclosures hold the facts, used in answers as {section.key}. Patterns are Python regexes matched against the field label lower-cased and without diacritics. Edit with a short Python script (json, ensure_ascii=False, indent=2), never by hand.",
  "settings": {
    "auto_submit": false,
    "voluntary_default_options": [
      "Prefer not to say",
      "I prefer not to say",
      "Decline to self-identify",
      "I don't wish to answer",
      "Prefer not to disclose"
    ]
  },
  "contact": {
    "first_name": "",
    "last_name": "",
    "full_name": "",
    "email": "",
    "phone": "",
    "phone_country_code": "",
    "city": "",
    "country": "",
    "linkedin": "",
    "github": "",
    "portfolio": ""
  },
  "screening": {
    "current_company": "",
    "current_title": "",
    "work_authorization": "",
    "requires_visa_sponsorship": "",
    "notice_period": "",
    "salary_expectation": "",
    "willing_to_relocate": "",
    "preferred_work_mode": "",
    "earliest_start_date": "",
    "how_did_you_hear": ""
  },
  "voluntary_disclosures": {
    "gender": "Prefer not to say",
    "ethnicity": "Prefer not to say",
    "veteran_status": "Prefer not to say",
    "disability": "Prefer not to say"
  },
  "do_not_answer": [
    {"id": "government_id", "patterns": ["national id", "personal (identification|id) (number|code)", "\\bssn\\b", "social security", "passport", "\\bcnp\\b", "carte de identitate"]},
    {"id": "birth_date", "patterns": ["date of birth", "birth ?date", "data nasterii"]},
    {"id": "criminal_record", "patterns": ["criminal", "convicted", "cazier"]},
    {"id": "credentials", "patterns": ["password", "parola"]}
  ],
  "consents": [
    {"id": "this_application_data", "patterns": ["process(ing)? (of )?my (personal )?data", "privacy (policy|notice)", "prelucrarea datelor"], "answer": null, "option_prefs": ["Yes", "I agree", "Da"]},
    {"id": "future_recruitment", "patterns": ["future (job )?opportunit", "other (positions|roles|vacancies)", "talent (pool|community)"], "answer": null, "option_prefs": ["Yes", "I agree", "Da"]},
    {"id": "marketing", "patterns": ["newsletter", "marketing", "job alerts"], "answer": null, "option_prefs": ["No", "Nu"]}
  ],
  "question_bank": [
    {"id": "first_name", "patterns": ["^first name$", "^given name$", "^prenume$"], "answer": "{contact.first_name}"},
    {"id": "last_name", "patterns": ["^last name$", "^family name$", "^surname$", "^nume( de familie)?$"], "answer": "{contact.last_name}"},
    {"id": "full_name", "patterns": ["^(full )?name$", "^nume (si prenume|complet)$"], "answer": "{contact.full_name}"},
    {"id": "email", "patterns": ["e-?mail"], "answer": "{contact.email}"},
    {"id": "phone", "patterns": ["phone|mobile|telefon"], "answer": "{contact.phone}"},
    {"id": "city", "patterns": ["^city$", "^oras$", "^localitate$"], "answer": "{contact.city}"},
    {"id": "country", "patterns": ["^country$", "^tara$"], "answer": "{contact.country}"},
    {"id": "linkedin", "patterns": ["linkedin"], "answer": "{contact.linkedin}", "optional_blank": true},
    {"id": "github", "patterns": ["github"], "answer": "{contact.github}", "optional_blank": true},
    {"id": "portfolio", "patterns": ["portfolio|personal website|^website$"], "answer": "{contact.portfolio}", "optional_blank": true},
    {"id": "current_company", "patterns": ["current (company|employer)", "angajator(ul)? actual"], "answer": "{screening.current_company}"},
    {"id": "current_title", "patterns": ["current (job )?title", "current (role|position)", "pozitia actuala"], "answer": "{screening.current_title}"},
    {"id": "work_authorization", "patterns": ["(legally )?(authori[sz]ed|eligible|right) to work", "work permit", "drept de munca"], "answer": "{screening.work_authorization}"},
    {"id": "visa_sponsorship", "patterns": ["sponsor", "viza de munca"], "answer": "{screening.requires_visa_sponsorship}"},
    {"id": "notice_period", "patterns": ["notice period", "\\bnotice\\b", "preaviz"], "answer": "{screening.notice_period}"},
    {"id": "salary", "patterns": ["salary", "compensation", "remuneration", "salariu", "pretentii salariale"], "answer": "{screening.salary_expectation}"},
    {"id": "relocation", "patterns": ["relocat", "mutare"], "answer": "{screening.willing_to_relocate}"},
    {"id": "work_mode", "patterns": ["work (mode|arrangement|setup)", "remote|hybrid|on-?site"], "answer": "{screening.preferred_work_mode}"},
    {"id": "start_date", "patterns": ["start date", "when (can|could) you start", "earliest", "data (de )?inceper"], "answer": "{screening.earliest_start_date}"},
    {"id": "how_heard", "patterns": ["how did you (hear|find|learn)", "where did you (hear|find)", "^source$", "cum ai aflat"], "answer": "{screening.how_did_you_hear}", "option_prefs": []},
    {"id": "referral", "patterns": ["referr", "recommended by", "recomandat de"], "answer": null, "optional_blank": true},
    {"id": "gender", "patterns": ["gender", "\\bsex\\b", "^gen$"], "answer": "{voluntary_disclosures.gender}", "option_prefs": "voluntary"},
    {"id": "ethnicity", "patterns": ["ethnic|race"], "answer": "{voluntary_disclosures.ethnicity}", "option_prefs": "voluntary"},
    {"id": "veteran", "patterns": ["veteran"], "answer": "{voluntary_disclosures.veteran_status}", "option_prefs": "voluntary"},
    {"id": "disability", "patterns": ["disabilit|dizabilit"], "answer": "{voluntary_disclosures.disability}", "option_prefs": "voluntary"}
  ],
  "free_text": {
    "_info": "Questions written per job from the CV draft and the skills pool (apply-to-job step 4); never stored here.",
    "patterns": ["\\bwhy\\b", "motivat", "cover letter", "tell us", "describe", "additional information", "anything (else|you'?d like)", "about (you|yourself)", "de ce"]
  }
}
